# Example values only. Copy to .env and replace targets for your local installation.
# Never commit .env or real credentials.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Safe default: web UIs listen on host loopback, not the LAN or public internet.
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_HOST_PORT=9090
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_HOST_PORT=3000

# Safe placeholders. Replace with the real private targets in the local .env.
ROUTER_PROBE_TARGET=192.0.2.1
INTERNET_CONNECTIVITY_TARGET=1.1.1.1
JELLYFIN_TARGET_URL=http://jellyfin.example.invalid:8096/
OPPORTUNITY_RADAR_TARGET_URL=http://opportunity-radar.example.invalid:18080/
QBITTORRENT_TARGET_URL=http://qbittorrent.example.invalid:8085/
PROWLARR_TARGET_URL=http://prowlarr.example.invalid:9696/
SEERR_TARGET_URL=http://seerr.example.invalid:5055/
SONARR_TARGET_URL=http://sonarr.example.invalid:8989/
