# Example values only. Copy to .env and replace both passwords with unique random secrets.
# Never commit .env, database dumps, or real credentials.

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=homelab
POSTGRES_USER=homelab_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

PGADMIN_IMAGE=dpage/pgadmin4:9.18
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Safe default: pgAdmin listens only on the server's loopback interface.
# For remote access, prefer an SSH tunnel. Do not set this to 0.0.0.0.
PGADMIN_BIND_IP=127.0.0.1
PGADMIN_PORT=5050
